# Copy this to .env and fill in values

SECRET_KEY=your-secret-key-here-generate-with-python-secrets
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# For local dev, leave blank to use SQLite
# For Railway/Render, they set this automatically
DATABASE_URL=

# Only needed in production (your deployed frontend URL)
CORS_ALLOWED_ORIGINS=
